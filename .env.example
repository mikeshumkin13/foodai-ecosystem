# Core / Базовые настройки
APP_ENV=local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_CSRF_COOKIE_HTTPONLY=false
DJANGO_CSRF_COOKIE_NAME=csrftoken
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_LANGUAGE_CODE=ru
DJANGO_TIME_ZONE=UTC
DJANGO_STATIC_URL=static/
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_SESSION_COOKIE_HTTPONLY=true
DJANGO_SESSION_COOKIE_NAME=sessionid
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SESSION_SAVE_EVERY_REQUEST=true
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_RUN_MIGRATIONS=true
BACKEND_PORT=8000
AUTH_EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=86400
AUTH_PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
AUTH_REGISTER_THROTTLE_RATE=5/hour
AUTH_LOGIN_THROTTLE_RATE=5/minute
AUTH_LOGOUT_THROTTLE_RATE=20/minute
AUTH_REFRESH_THROTTLE_RATE=20/minute
AUTH_EMAIL_VERIFICATION_THROTTLE_RATE=10/hour
AUTH_PASSWORD_RESET_THROTTLE_RATE=5/hour
AUTH_PASSWORD_CHANGE_THROTTLE_RATE=5/hour
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=security@foodai.local
FRONTEND_BASE_URL=http://localhost:3000
FOOD_SCAN_ALLOWED_FORMATS=JPEG,PNG
FOOD_SCAN_MAX_UPLOAD_BYTES=5242880
FOOD_SCAN_MAX_IMAGE_PIXELS=20000000
FOOD_SCAN_PRIVATE_STORAGE_BACKEND=local
FOOD_SCAN_PRIVATE_MEDIA_ROOT=/app/local_uploads/private

# Backend / Backend
DJANGO_SECRET_KEY=change-me-local-only
DATABASE_URL=postgres://foodai:foodai-local-password@postgres:5432/foodai
REDIS_URL=redis://:foodai-local-password@redis:6379/0

# PostgreSQL
POSTGRES_DB=foodai
POSTGRES_USER=foodai
POSTGRES_PASSWORD=foodai-local-password

# Redis
REDIS_PASSWORD=foodai-local-password

# Private S3-compatible storage / Приватное S3-совместимое хранилище
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=local
S3_BUCKET_PRIVATE=foodai-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# MinIO local development / MinIO для локальной разработки
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only

# Vision service / Vision-сервис
VISION_SERVICE_URL=http://localhost:8001
