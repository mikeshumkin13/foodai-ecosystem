# Core / Базовые настройки
APP_ENV=local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend / Backend
DJANGO_SECRET_KEY=change-me-local-only
DATABASE_URL=postgres://foodai:change-me-local-only@localhost:5432/foodai
REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# PostgreSQL
POSTGRES_DB=foodai
POSTGRES_USER=foodai
POSTGRES_PASSWORD=change-me-local-only

# Redis
REDIS_PASSWORD=change-me-local-only

# Private S3-compatible storage / Приватное S3-совместимое хранилище
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=local
S3_BUCKET_PRIVATE=foodai-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# MinIO local development / MinIO для локальной разработки
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only

# Vision service / Vision-сервис
VISION_SERVICE_URL=http://localhost:8001

